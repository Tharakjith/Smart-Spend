# Copy to .env and replace every CHANGE_ME. Never commit .env.

ENVIRONMENT=production
# 64+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
# Fernet key for encrypting MFA secrets:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME
COOKIE_SECURE=true
FRONTEND_URL=https://smartspend.example.com
CORS_ORIGINS=["https://smartspend.example.com"]
REQUIRE_EMAIL_VERIFICATION=true

POSTGRES_USER=smartspend
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=smartspend

MINIO_ROOT_USER=smartspend
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=smartspend-documents

# Outgoing email for verification and password reset. Without SMTP, emails are only written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartSpend <no-reply@smartspend.example.com>

MAX_UPLOAD_BYTES=15728640
# none | clamav  (start the "scan" compose profile for clamav)
MALWARE_SCANNER=none
CLAMAV_HOST=clamav
# auto = Tesseract if installed, else RapidOCR (pip); none disables OCR
OCR_PROVIDER=auto

# Optional AI suggestions. Off unless BOTH settings below are enabled AND a household opts in.
# When on, extracted document text is sent to the provider. Review the privacy notice in docs/SECURITY.md.
AI_PROVIDER=none
AI_ALLOW_DOCUMENT_SHARING=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

RATE_LIMIT_AUTH_PER_MINUTE=10
DEMO_MODE=false
WEB_PORT=8080
